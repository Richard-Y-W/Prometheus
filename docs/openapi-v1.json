            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "type": "object",
        "title": "ResearchRequest"
      },
      "ReviewDecision": {
        "properties": {
          "field_name": {
            "type": "string",
            "title": "Field Name"
          },
          "status": {
            "type": "string",
            "pattern": "^(accepted|rejected)$",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "field_name",
          "status"
        ],
        "title": "ReviewDecision"
      },
      "ReviewRequest": {
        "properties": {
          "reviewed_by": {
            "type": "string",
            "minLength": 1,
            "title": "Reviewed By"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/ReviewDecision"
            },
            "type": "array",
            "title": "Decisions"
          }
        },
        "type": "object",
        "required": [
          "reviewed_by",
          "decisions"
        ],
        "title": "ReviewRequest"
      },
      "ScenarioCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "default": "Motor arm duty cycle"
          },
          "natural_language_description": {
            "type": "string",
            "title": "Natural Language Description"
          },
          "definition": {
            "$ref": "#/components/schemas/ScenarioDefinition"
          }
        },
        "type": "object",
        "required": [
          "natural_language_description",
          "definition"
        ],
        "title": "ScenarioCreate"
      },
      "ScenarioDefinition": {
        "properties": {
          "payload_kg": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Payload Kg"
          },
          "arm_length_m": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Arm Length M"
          },
          "rotation_deg": {
            "type": "number",
            "maximum": 360.0,
            "exclusiveMinimum": 0.0,
            "title": "Rotation Deg"
          },
          "movement_s": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Movement S"
          },
          "hold_s": {
            "type": "number",
            "minimum": 0.0,
            "title": "Hold S"
          },
          "cycle_s": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Cycle S"
          },
          "ambient_c": {
            "type": "number",
            "maximum": 150.0,
            "minimum": -40.0,
            "title": "Ambient C"
          },
          "safety_factor": {
            "type": "number",
            "minimum": 1.0,
            "title": "Safety Factor",
            "default": 1.2
          }
        },
        "type": "object",
        "required": [
          "payload_kg",
          "arm_length_m",
          "rotation_deg",
          "movement_s",
          "hold_s",
          "cycle_s",
          "ambient_c"
        ],
        "title": "ScenarioDefinition"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}