  "properties": {
    "$schema": {
      "const": "urn:prometheus:schema:execution-component:2.0.0",
      "title": "$Schema",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactReferenceV2"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "authority": {
      "$ref": "#/$defs/ExecutionAuthorityV2"
    },
    "capability_id": {
      "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
      "title": "Capability Id",
      "type": "string"
    },
    "claim_reviews": {
      "items": {
        "$ref": "#/$defs/EffectiveClaimReviewV2"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Claim Reviews",
      "type": "array"
    },
    "claims": {
      "items": {
        "discriminator": {
          "mapping": {
            "known": "#/$defs/KnownCandidateClaimV2",
            "unknown": "#/$defs/UnknownCandidateClaimV2"
          },
          "propertyName": "value_state"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/KnownCandidateClaimV2"
          },
          {
            "$ref": "#/$defs/UnknownCandidateClaimV2"
          }
        ]
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "component": {
      "$ref": "#/$defs/ComponentIdentityV2"
    },
    "evidence": {
      "items": {
        "discriminator": {
          "mapping": {
            "derived_claim": "#/$defs/DerivedClaimEvidenceV2",
            "manufacturer_document": "#/$defs/ManufacturerDocumentEvidenceV2",
            "private_upload": "#/$defs/PrivateUploadEvidenceV2",
            "user_measurement": "#/$defs/UserMeasurementEvidenceV2",
            "validation_observation": "#/$defs/ValidationObservationEvidenceV2"
          },
          "propertyName": "evidence_class"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ManufacturerDocumentEvidenceV2"
          },
          {
            "$ref": "#/$defs/PrivateUploadEvidenceV2"
          },
          {
            "$ref": "#/$defs/UserMeasurementEvidenceV2"
          },
          {
            "$ref": "#/$defs/DerivedClaimEvidenceV2"
          },
          {
            "$ref": "#/$defs/ValidationObservationEvidenceV2"
          }
        ]
      },
      "maxItems": 10000,
      "title": "Evidence",
      "type": "array"
    },
    "execution_readiness": {
      "enum": [
        "ready",
        "blocked"
      ],
      "title": "Execution Readiness",
      "type": "string"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/CapabilityGateV2"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Gates",
      "type": "array"
    },
    "limitations": {
      "items": {
        "$ref": "#/$defs/LimitationV2"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "missing_information": {
      "items": {
        "$ref": "#/$defs/MissingInformationV2"
      },
      "maxItems": 10000,
