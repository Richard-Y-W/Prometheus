      "type": "array"
    },
    "package_compiler": {
      "$ref": "#/$defs/PackageCompilerV2"
    },
    "package_kind": {
      "const": "component_execution_input",
      "title": "Package Kind",
      "type": "string"
    },
    "parameter_slots": {
      "items": {
        "$ref": "#/$defs/ParameterSlotV2"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Parameter Slots",
      "type": "array"
    },
    "reviewed_draft_version": {
      "minimum": 1,
      "title": "Reviewed Draft Version",
      "type": "integer"
    },
    "revision_id": {
