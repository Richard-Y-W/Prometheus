{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheus.local/schemas/execution-component/v1",
  "title": "Reviewed component execution input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_kind",
    "revision_id",
    "content_hash",
    "component",
    "certification",
    "parameters",
    "evidence",
    "supported_recipes",
    "missing_information",
    "limitations",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_kind": {"const": "component_execution_input"},
    "revision_id": {"type": "string", "format": "uuid"},
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manufacturer", "part_number", "revision", "component_class"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "manufacturer": {"type": "string", "minLength": 1},
        "part_number": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "component_class": {"type": "string", "minLength": 1}
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "status", "published_at"],
      "properties": {
        "tier": {
          "enum": [
            "provisional",
            "geometry_verified",
            "behavior_verified",
            "physically_validated",
            "system_validated"
          ]
        },
        "status": {"const": "published"},
        "published_at": {"type": "string", "format": "date-time"}
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "quantity",
          "dimension",
          "value",
          "unit",
          "original_value",
          "original_unit",
          "validity_conditions",
          "evidence_ids"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "quantity": {"type": "string", "minLength": 1},
          "dimension": {"type": "string", "minLength": 1},
          "value": {"$ref": "https://prometheus.local/schemas/engineering-value/v1"},
          "unit": {"type": "string", "minLength": 1},
          "original_value": {"type": "string", "minLength": 1},
          "original_unit": {"type": "string", "minLength": 1},
          "validity_conditions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "format": "uuid"}
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://prometheus.local/schemas/evidence-record/v1"}
    },
    "supported_recipes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_name", "reason"],
        "properties": {
          "field_name": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_role", "engineering_decision_authority"],
      "properties": {
        "package_role": {"const": "reviewed_input"},
        "engineering_decision_authority": {"const": "prometheus_cpp"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "certification": {
            "properties": {"tier": {"const": "provisional"}},
            "required": ["tier"]
          }
        },
        "required": ["certification"]
      },
      "then": {
        "properties": {"limitations": {"minItems": 1}}
      }
    }
  ]
}
