{
  "$defs": {
    "DerivedClaimEvidenceV2": {
      "additionalProperties": false,
      "properties": {
        "derivation_method": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Derivation Method",
          "type": "string"
        },
        "evidence_class": {
          "const": "derived_claim",
          "title": "Evidence Class",
          "type": "string"
        },
        "evidence_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "extraction_confidence": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Confidence"
        },
        "limitations": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Limitations",
          "type": "array"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "parent_claim_ids": {
          "items": {
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Parent Claim Ids",
          "type": "array"
        },
        "parent_evidence_ids": {
          "items": {
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Parent Evidence Ids",
          "type": "array"
        },
        "physical_validation_status": {
          "enum": [
            "unvalidated",
            "component_validated",
            "system_validated"
          ],
          "title": "Physical Validation Status",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Revision Id",
          "type": "string"
        },
        "source_authority": {
          "const": "prometheus_derivation",
          "title": "Source Authority",
          "type": "string"
        },
        "source_locator": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Locator"
        },
        "source_uri": {
          "anyOf": [
            {
              "format": "uri",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        }
      },
      "required": [
        "evidence_id",
        "revision_id",
        "evidence_class",
        "source_authority",
        "physical_validation_status",
        "limitations",
        "derivation_method",
        "parent_claim_ids",
        "parent_evidence_ids"
