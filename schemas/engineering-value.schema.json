{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheus.local/schemas/engineering-value/v1",
  "title": "Engineering value",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "scalar"},
        "value": {"type": "number"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "minimum", "maximum"],
      "properties": {
        "kind": {"const": "range"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "values"],
      "properties": {
        "kind": {"const": "enumeration"},
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {"type": "string"},
              {"type": "number"},
              {"type": "boolean"}
            ]
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "independent_quantity",
        "independent_unit",
        "interpolation",
        "points"
      ],
      "properties": {
        "kind": {"const": "curve"},
        "independent_quantity": {"type": "string", "minLength": 1},
        "independent_unit": {"type": "string", "minLength": 1},
        "interpolation": {"enum": ["linear", "step", "cubic"]},
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"}
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {"const": "unknown"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  ]
}
